    </wiz_part>
    <wiz_part part="ION_INTERFACE" preset="UHPLC">
        <parameter name="Smoothing">true</parameter>
        <parameter name="Stable ionization across samples">true</parameter>
        <parameter name="Crop retention time">
            <min>0.3</min>
            <max>30.0</max>
        </parameter>
        <parameter name="Max peaks in chromatogram">15</parameter>
        <parameter name="Minimum consecutive scans">6</parameter>
        <parameter name="Approximate feature FWHM" unit="MINUTES">0.03</parameter>
        <parameter name="RT tolerance (intra-sample)" unit="MINUTES">0.04</parameter>
        <parameter name="RT tolerance (sample-to-sample)" unit="MINUTES">0.1</parameter>
    </wiz_part>
    <wiz_part part="IMS" preset="NO_IMS">
        <parameter name="IMS active">false</parameter>
        <parameter name="Smoothing">true</parameter>
        <parameter name="IMS type">NONE</parameter>
        <parameter name="Minimum consecutive scans">5</parameter>
        <parameter name="Approximate feature FWHM">0.01</parameter>
    </wiz_part>
    <wiz_part part="MS" preset="Orbitrap">
        <parameter name="Ion mode">Positive</parameter>
        <parameter choices="ABSOLUTE_NOISE_LEVEL,FACTOR_OF_LOWEST_SIGNAL" ms1_level="5.0" msn_level="2.5" name="Noise threshold" selected_value="FACTOR_OF_LOWEST_SIGNAL"/>
        <parameter name="Minimum feature height">500000.0</parameter>
        <parameter name="m/z tolerance (scan-to-scan)">
            <absolutetolerance>0.002</absolutetolerance>
            <ppmtolerance>10.0</ppmtolerance>
        </parameter>
        <parameter name="m/z tolerance (intra-sample)">
            <absolutetolerance>0.0015</absolutetolerance>
            <ppmtolerance>3.0</ppmtolerance>
        </parameter>
        <parameter name="m/z tolerance (sample-to-sample)">
            <absolutetolerance>0.0015</absolutetolerance>
            <ppmtolerance>5.0</ppmtolerance>
        </parameter>
    </wiz_part>
    <wiz_part part="FILTER" preset="Filters">
        <parameter name="Original feature list">REMOVE</parameter>
        <parameter name="Minimum aligned samples">
            <abs>3</abs>
            <rel>0.0</rel>
        </parameter>
        <parameter name="Minimum aligned samples (in any group)" selected="true">
            <parameter name="Minimum samples">
                <abs>3</abs>
                <rel>0.0</rel>
            </parameter>
            <parameter name="Metadata grouping">condition</parameter>
        </parameter>
        <parameter name="Pooled QC area RSD ≤ 20%">false</parameter>
        <parameter name="Only keep features with 13C">false</parameter>
        <parameter name="Apply strict shape filtering">false</parameter>
    </wiz_part>
    <wiz_part part="ANNOTATION" preset="Annotation">
        <parameter name="Local compound database search" selected="false">
            <parameter name="Database file"/>
            <parameter name="Use precursor m/z">as calculated from neutral mass (or formula/smiles) + ions</parameter>
            <parameter name="Filename column (for library generation)" selected="false">filename</parameter>
            <parameter name="Columns">
                <importtype column="neutral_mass" datatype="io.github.mzmine.datamodel.features.types.numbers.NeutralMassType" selected="true"/>
                <importtype column="mz" datatype="io.github.mzmine.datamodel.features.types.numbers.PrecursorMZType" selected="true"/>
                <importtype column="rt" datatype="io.github.mzmine.datamodel.features.types.numbers.RTType" selected="true"/>
                <importtype column="ri_record" datatype="io.github.mzmine.datamodel.features.types.RIRecordType" selected="false"/>
                <importtype column="formula" datatype="io.github.mzmine.datamodel.features.types.annotations.formula.FormulaType" selected="true"/>
                <importtype column="smiles" datatype="io.github.mzmine.datamodel.features.types.annotations.SmilesStructureType" selected="true"/>
                <importtype column="inchi" datatype="io.github.mzmine.datamodel.features.types.annotations.InChIStructureType" selected="false"/>
                <importtype column="inchi_key" datatype="io.github.mzmine.datamodel.features.types.annotations.InChIKeyStructureType" selected="false"/>
                <importtype column="name" datatype="io.github.mzmine.datamodel.features.types.annotations.CompoundNameType" selected="true"/>
                <importtype column="CCS" datatype="io.github.mzmine.datamodel.features.types.numbers.CCSType" selected="false"/>
                <importtype column="mobility" datatype="io.github.mzmine.datamodel.features.types.numbers.MobilityType" selected="false"/>
                <importtype column="comment" datatype="io.github.mzmine.datamodel.features.types.annotations.CommentType" selected="true"/>
                <importtype column="adduct" datatype="io.github.mzmine.datamodel.features.types.annotations.iin.IonTypeType" selected="false"/>
                <importtype column="PubChemCID" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.PubChemIdType" selected="false"/>
                <importtype column="molecular_class" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.MolecularClassType" selected="false"/>
                <importtype column="classyfire_superclass" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.ClassyFireSuperclassType" selected="false"/>
                <importtype column="classyfire_class" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.ClassyFireClassType" selected="false"/>
                <importtype column="classyfire_subclass" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.ClassyFireSubclassType" selected="false"/>
                <importtype column="classyfire_direct_parent" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.ClassyFireParentType" selected="false"/>
                <importtype column="npclassifier_superclass" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.NPClassifierSuperclassType" selected="false"/>
                <importtype column="npclassifier_class" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.NPClassifierClassType" selected="false"/>
                <importtype column="npclassifier_pathway" datatype="io.github.mzmine.datamodel.features.types.annotations.compounddb.NPClassifierPathwayType" selected="false"/>
                <importtype column="q3_quantifier_mz" datatype="io.github.mzmine.datamodel.features.types.numbers.Q3QuantMzType" selected="false"/>
                <importtype column="iupac_name" datatype="io.github.mzmine.datamodel.features.types.identifiers.IupacNameType" selected="false"/>
                <importtype column="cas" datatype="io.github.mzmine.datamodel.features.types.identifiers.CASType" selected="false"/>
                <importtype column="internal_id" datatype="io.github.mzmine.datamodel.features.types.identifiers.InternalIdType" selected="false"/>
            </parameter>
        </parameter>
        <parameter name="Annotate lipids">true</parameter>
        <parameter name="Formula prediction (for m/z &lt; X)" selected="false">600.0</parameter>
        <parameter name="Spectral library files"/>
    </wiz_part>
    <wiz_part part="WORKFLOW" preset="DDA">
        <parameter name="Apply spectral networking (FBMN/IIMN)">true</parameter>
        <parameter name="Export path" selected="true">
            <current_file>/lisc/home/user/samrat/snakeautomatic/data/raw/OE23-POS/OE23</current_file>
            <last_file>/lisc/home/user/samrat/snakeautomatic/data/raw/OE23-POS/OE23</last_file>
            <last_file>/lisc/home/user/samrat/D:\workshop\mzmine-microbial-results</last_file>
        </parameter>
        <parameter name="Export for molecular networking (e.g., GNPS, FBMN, IIMN, MetGem)">true</parameter>
        <parameter name="Export for SIRIUS">true</parameter>
        <parameter name="Export annotation graphics">false</parameter>
    </wiz_part>
</wizard>
